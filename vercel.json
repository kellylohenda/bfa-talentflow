{
  "version": 2,
  "outputDirectory": "project",
  "cleanUrls": false,
  "routes": [
    {
      "src": "/",
      "dest": "/BFA%20TalentFlow.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.jsx)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
